{
  "name": "101-coffee-cost-finance",
  "version": "0.1.0",
  "private": true,
  "description": "101 COFFEE Finance web application.",
  "scripts": {
    "dev": "vite --host localhost",
    "start": "vite --host localhost",
    "build": "vite build",
    "test:finance": "node scripts/finance-regression.mjs",
    "test:inventory": "node scripts/inventory-regression.mjs && node scripts/inventory-analytics-regression.mjs",
    "test:emulator": "node scripts/final-emulator-regression.mjs && node scripts/sale-permission-regression.mjs",
    "test:debts": "node scripts/debt-regression.mjs",
    "test:expense-debt": "node scripts/expense-debt-emulator.mjs",
    "test:barcode": "node scripts/barcode-camera-regression.mjs",
    "test:phase2-financial": "node scripts/phase2-financial-regression.mjs",
    "test:chart": "node scripts/chart-regression.mjs",
    "test:comparison": "node scripts/comparison-regression.mjs",
    "test:realtime": "node scripts/realtime-regression.mjs",
    "test:month-carry": "node scripts/month-carry-regression.mjs",
    "test:improvements": "node scripts/notification-regression.mjs && node scripts/improvements-emulator-regression.mjs",
    "test:rules-matrix": "node scripts/rules-matrix-regression.mjs",
    "test:closed-month": "node scripts/closed-month-rules-regression.mjs",
    "test:payment-review": "node scripts/payment-review-regression.mjs",
    "test:shift": "node scripts/shift-regression.mjs",
    "test:owner-cash": "node scripts/owner-cash-regression.mjs",
    "test:historical-import": "node scripts/historical-import-emulator-regression.mjs",
    "test:historical-asset-classification": "node scripts/historical-asset-classification-emulator-regression.mjs",
    "test:historical-classification-batch": "node scripts/historical-classification-batch-emulator-regression.mjs",
    "test:historical-management": "node scripts/historical-import-management-emulator-regression.mjs",
    "test:partners-establishment-reset": "node scripts/partners-establishment-reset-regression.mjs",
    "test:partner-operations": "node scripts/partner-operations-emulator-regression.mjs",
    "check": "node scripts/check-permissions.mjs && vite build",
    "build:firebase": "vite build --mode firebase",
    "build:github": "vite build --mode github && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@zxing/browser": "^0.2.1",
    "firebase": "^12.18.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.542.0",
    "qrcode": "^1.5.4",
    "recharts": "^3.1.2",
    "vite": "^7.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "firebase-admin": "^14.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2"
  }
}
