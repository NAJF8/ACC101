      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'manager')"
    },
    "purchases": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() != 'viewer')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() != 'viewer')"
    },
